{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "root_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "author_constraints": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "level": {
            "enum": [
              "book",
              "volume",
              "chapter"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "subtitle": {
            "type": "string",
            "minLength": 0,
            "maxLength": 500
          },
          "planning_status": {
            "enum": [
              "unplanned",
              "planning",
              "planned",
              "needs_revision"
            ]
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "maxItems": 1000,
            "uniqueItems": true
          },
          "archived": {
            "type": "boolean"
          },
          "target_chapters": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "target_words": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "detail_ref": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "object_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "object_id",
                  "revision",
                  "sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "level",
          "title",
          "subtitle",
          "planning_status",
          "children",
          "archived",
          "target_chapters",
          "target_words",
          "detail_ref"
        ]
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "story_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "object_id",
            "revision",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "maxItems": 200,
      "uniqueItems": true
    }
  },
  "required": [
    "format_version",
    "root_id",
    "author_constraints",
    "nodes",
    "story_ref",
    "run_ids"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HetuDesignNovelPlan"
}
