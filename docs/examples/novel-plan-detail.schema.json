{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "goal": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "theme": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "opening": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "conflict": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "start_state": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "end_state": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "hook": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 12000
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 12000
      },
      "maxItems": 100
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 12000
      },
      "maxItems": 100
    },
    "detailed_plot": {
      "type": "string",
      "minLength": 0,
      "maxLength": 120000
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 0,
            "maxLength": 12000
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "maxItems": 100
          },
          "clue_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "entity_ids",
          "clue_ids"
        ]
      },
      "maxItems": 300
    },
    "entity_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "notes": {
            "type": "string",
            "minLength": 0,
            "maxLength": 12000
          }
        },
        "required": [
          "entity_id",
          "role",
          "notes"
        ]
      },
      "maxItems": 300
    },
    "formal_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "revision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "document_id",
          "revision_id",
          "sha256"
        ]
      },
      "maxItems": 100
    }
  },
  "required": [
    "format_version",
    "plan_id",
    "node_id",
    "summary",
    "goal",
    "theme",
    "opening",
    "conflict",
    "start_state",
    "end_state",
    "hook",
    "notes",
    "turns",
    "questions",
    "detailed_plot",
    "beats",
    "entity_links",
    "formal_documents"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HetuDesignNovelPlanDetail"
}
